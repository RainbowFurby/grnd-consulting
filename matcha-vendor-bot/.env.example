# Copy this file to .env and fill in the two values.
#   cp .env.example .env
#
# .env is gitignored. Never commit it, never paste these values into a chat.

# From @BotFather on Telegram (/newbot). Looks like 8123456789:AAH...
TELEGRAM_BOT_TOKEN=

# The group chat the bot posts into. Group ids are NEGATIVE, e.g. -1001234567890
# See README step 3 for how to find it.
TELEGRAM_CHAT_ID=
